MIU.LO(t,n)   = 0;
MIU.UP(t,n)   = miuup(t,n);
MIU.FX("1",n) = ECO("MIU0",N);



MIU.FX(t,n) = 0;
SOLVE RICE MAXIMIZING UTILITY  USING NLP;

