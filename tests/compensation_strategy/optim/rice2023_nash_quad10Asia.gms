* Ccntrol rate limits
miu.up(t,n) = miuup(t,n);
S.fx(t,n)         = optlrsav;
*S.UP(t,n)         = 1;
K.LO(t,n)         = 1;
C.LO(t,n)         = 0.05;
CPC.LO(t,n)       = .001;


*Control for terminal savings rate
*set lag10(t) ;
*lag10(t) =  yes$(t.val gt card(t)-10);
*S.FX(lag10(t)) = optlrsav;
*ri.fx(tlast) = .014;

* Initial conditions
ccatot.fx(tfirst) = CumEmiss0;
k.FX(tfirst,n)      = ECO("k0",n);
F_GHGabate.fx(tfirst) = F_GHGabate2020;

** Solution options
option iterlim = 99900;
option reslim = 99999;
option solprint = on;
option limrow = 0;
option limcol = 0;

model  RICE /all/;


********************************************************************************
*****///////////                 Nash Equilibrium               ///////////*****
********************************************************************************

**release the bounds
*M.LO(T)    = 0.5*M0;
*M.UP(T)    = 15000;



file resLARGE2022 /rice2023_nash_quad.csv/; resLARGE2022.nd = 10 ; resLARGE2022.nw = 0 ; resLARGE2022.pw=20000; resLARGE2022.pc=5;
put resLARGE2022;
put /"Results of rice2023_nash_quad.csv with final results: July 19, 2023";


miu.lo(t,n) = 1E-6;
MIU.UP(t,n)   = miuup(t,n);
MIU.FX("1",n) = ECO("MIU0",N);



******////////////////////////////////////////////////////////////////////******
*************************** Calculate Nash Equilibrium *************************
******/////////////////////////////formula/////////////////////////////////******

PARAMETERS
